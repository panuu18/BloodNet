# ===================================================
# BloodNet+ Backend Environment Configuration
# ===================================================

# Server Runtime
NODE_ENV=production
PORT=5000

# Database Configuration (MongoDB Atlas connection string)
# Replace <username>, <password>, and <cluster> with your Atlas cluster details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bloodnet?retryWrites=true&w=majority

# Authentication & Security
# Generate a strong 32+ character random string for production
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# CORS & Client Integration (Set to your live frontend URL)
CLIENT_URL=https://bloodnet-plus-eight.vercel.app
FRONTEND_URL=https://bloodnet-plus-eight.vercel.app
CORS_ORIGIN=https://bloodnet-plus-eight.vercel.app
CORS_CREDENTIALS=true

# File Upload Settings (Optional)
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
