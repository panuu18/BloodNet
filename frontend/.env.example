# ===========================================
# BloodNet+ Frontend Environment Variables
# ===========================================

# Google Maps API Configuration
REACT_APP_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
# Get your API key from: https://console.cloud.google.com/
# Enable: Maps JavaScript API, Geocoding API

# Backend API Configuration
REACT_APP_API_URL=http://localhost:5000
# For production: REACT_APP_API_URL=https://api.bloodnetplus.com

# Application Configuration
REACT_APP_NAME=BloodNet+
REACT_APP_VERSION=1.0.0
REACT_APP_DESCRIPTION=Real-time blood donation platform

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_CHATBOT=false
REACT_APP_ENABLE_DARK_MODE=true

# Analytics and Tracking (Optional)
REACT_APP_GA_TRACKING_ID=your_google_analytics_id
REACT_APP_HOTJAR_ID=your_hotjar_id
REACT_APP_SENTRY_DSN=your_sentry_dsn_here

# Map Configuration
REACT_APP_MAP_DEFAULT_LAT=40.7128
REACT_APP_MAP_DEFAULT_LNG=-74.0060
REACT_APP_MAP_DEFAULT_ZOOM=12

# Socket.IO Configuration
REACT_APP_SOCKET_URL=http://localhost:5000
# For production: REACT_APP_SOCKET_URL=https://api.bloodnetplus.com

# File Upload Configuration
REACT_APP_MAX_FILE_SIZE=5242880
REACT_APP_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Notification Configuration
REACT_APP_NOTIFICATION_DURATION=5000
REACT_APP_ENABLE_SOUND_NOTIFICATIONS=true

# Development/Production Mode
NODE_ENV=development
REACT_APP_DEBUG=true

# External Services
REACT_APP_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
REACT_APP_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Cache Configuration
REACT_APP_CACHE_DURATION=300000
REACT_APP_ENABLE_OFFLINE_MODE=false
